# ============================================================================
# Smart Grade AI - Environment Configuration
# ============================================================================
# Copy this file to .env and update with your actual values
# This file follows twelve-factor app configuration best practices

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME="Smart Grade AI"
DEBUG=false
ENVIRONMENT=development

# ============================================================================
# SERVER SETTINGS
# ============================================================================
# Backend API server
HOST=0.0.0.0
BACKEND_PORT=8000
RELOAD=true

# Frontend server (for CORS and development)
FRONTEND_PORT=3000
FRONTEND_HOST=localhost

# ============================================================================
# SECURITY
# ============================================================================
# IMPORTANT: Change this to a strong random secret key in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# CORS SETTINGS
# ============================================================================
# Comma-separated list of allowed origins
# Note: These will be auto-generated from FRONTEND_HOST and FRONTEND_PORT if not set
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://smartgrade:@localhost:5432/smartgrade_db

# Database connection pool settings
DATABASE_ECHO=true
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ============================================================================
# REDIS CONFIGURATION (for caching)
# ============================================================================
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=10

# ============================================================================
# AI SERVICE CONFIGURATION - OLLAMA
# ============================================================================
# Ollama local LLM server
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.1

# ============================================================================
# AI SERVICE CONFIGURATION - OPENAI
# ============================================================================
# OpenAI API key (optional - for GPT models)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# ============================================================================
# AI SERVICE CONFIGURATION - ANTHROPIC
# ============================================================================
# Anthropic API key (optional - for Claude models)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_MAX_TOKENS=4000

# ============================================================================
# AI SERVICE CONFIGURATION - GOOGLE AI
# ============================================================================
# Google AI API key (for Gemini models)
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash-exp

# ============================================================================
# FILE UPLOAD SETTINGS
# ============================================================================
# Maximum file size in bytes (10MB default)
MAX_FILE_SIZE=10485760
# Comma-separated list of allowed file extensions
ALLOWED_FILE_TYPES=.pdf,.docx,.txt,.md

# Upload directory for storing files
UPLOAD_DIR=uploads

# ============================================================================
# AI GRADING SETTINGS
# ============================================================================
# Default AI model to use for grading (ollama, openai, anthropic)
DEFAULT_AI_PROVIDER=ollama
DEFAULT_AI_MODEL=llama2

# Maximum number of concurrent grading tasks
MAX_CONCURRENT_GRADINGS=5

# PDF text extraction limit (characters)
PDF_TEXT_MAX_LENGTH=30000

# Enable vision model for PDF image analysis
ENABLE_VISION_MODEL=false
VISION_MODEL_NAME=gpt-4-vision-preview

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=backend.log

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================
# Google Drive integration (optional)
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_AI_EXTRACTION=true
ENABLE_AI_GRADING=true
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=false

# ============================================================================
# MONITORING & ANALYTICS
# ============================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

